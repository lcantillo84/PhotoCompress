    "access.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Compress needs access to your library to save the compressed copies in their own album. It never changes or deletes your photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimir Fotos necesita acceso a tu biblioteca para guardar las copias comprimidas en su propio álbum. Nunca cambia ni borra tus fotos."
          }
        }
      }
    },
    "access.settings": {
      "extractionState": "manual",
      "localizations": {
