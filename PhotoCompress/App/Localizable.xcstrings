{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Compress"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimir Fotos"
          }
        }
      }
    },
    "home.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make photos fit any upload limit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos, del tamaño que te piden"
          }
        }
      }
    },
    "home.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us the size you need. We hit it, and keep the date, camera and location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinos el tamaño que necesitas y lo logramos, sin perder la fecha, la cámara ni la ubicación."
          }
        }
      }
    },
    "home.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir fotos"
          }
        }
      }
    },
    "home.preparing %lld %lld": {
      "extractionState": "manual",
