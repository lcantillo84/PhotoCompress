      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Compress saves the compressed copies to your library. It never changes or deletes your originals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimir Fotos guarda las copias comprimidas en tu biblioteca. Nunca cambia ni borra tus originales."
          }
        }
      }
    },
